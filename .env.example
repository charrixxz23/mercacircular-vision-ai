# Copie este archivo como ".env" (en esta misma carpeta raíz) si necesita cambiar algo.
# Todos los valores tienen un valor por defecto: la demo funciona sin crear .env.
# No contiene secretos: el prototipo no usa servicios externos ni claves.

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
# Base de datos. Por defecto: SQLite en database/mercacircular.db
# DATABASE_URL=sqlite:///database/mercacircular.db
# PostgreSQL (requiere: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/mercacircular

# Carpeta donde se guardan las fotos subidas (relativa a la raíz o absoluta)
MEDIA_DIR=database/media

# Modelo y métricas (se distribuyen en backend/models)
MODEL_PATH=backend/models/product_classifier_v1.json
METRICS_PATH=backend/models/metrics.json

# Datos demostrativos
SEED_DEMO_DATA=true
ALLOW_DEMO_RESET=true

# Orígenes permitidos por CORS (solo si llama a la API directamente desde otro origen)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Tamaño máximo de imagen en MB
MAX_UPLOAD_MB=10

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# Dirección del backend a la que Next.js reenvía /api, /media y /samples.
# Se lee al ejecutar "npm run dev" y al compilar con "npm run build".
# Defínala en frontend/.env.local (ver frontend/.env.example).
# BACKEND_URL=http://127.0.0.1:8000
